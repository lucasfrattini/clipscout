# Clipgeist: instalación conjunta (deploy/clipgeist/compose.yaml)

# La MISMA clave de API para las tres apps (32 caracteres hex: `openssl rand -hex 16`).
CLIPGEIST_CLAVE=

# Carpeta del servidor con los vídeos (la ven clipkeeper y clonbuster, en la misma ruta).
CARPETAS=/srv/videos

# Dónde guarda cada app sus datos (crea antes datos/clipscout, datos/clipkeeper, datos/clonbuster).
DATOS=./datos

# Puertos publicados en el servidor.
CLIPSCOUT_PUERTO=3001
CLIPKEEPER_PUERTO=8096
CLONBUSTER_PUERTO=8095

# Opcional: direcciones de la red local, para que los enlaces entre apps abran en el navegador.
# Sin ellas se usan los nombres internos (http://clipkeeper:8096…), que solo valen entre contenedores.
# CLIPGEIST_CLIPSCOUT_URL=http://192.168.1.10:3001
# CLIPGEIST_CLIPKEEPER_URL=http://192.168.1.10:8096
# CLIPGEIST_CLONBUSTER_URL=http://192.168.1.10:8095

# Usuario con el que corren clipkeeper y clonbuster (dueño de CARPETAS).
UID_GID=1000:1000
