{
  "name": "clipscout",
  "short_name": "clipscout",
  "description": "Busca vídeos en tus sitios y mándalos a tu gestor de descargas.",
  "id": "/",
  "start_url": "/#/buscar",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b1220",
  "theme_color": "#c2410c",
  "icons": [
    {
      "src": "/img/pwa/icono-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/pwa/icono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/pwa/icono-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/compartir",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
